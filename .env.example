# 复制为 .env 后按需修改；不提交真实凭据。
# docker compose 会自动读取同目录的 .env。

# 宿主机端口映射（被占用时改这里）
APP_PORT=3000
BACKEND_PORT=8080

# 模拟器参数：改完重启 backend 生效（运行中也可用 PUT /api/dev/simulation 热改）
SIM_ASSET_CHECK_MS=1200
SIM_GENERATING_MS=2500
SIM_FINALIZING_MS=900
# none / ASSET_CHECK / GENERATING / FINALIZING
SIM_FAIL_STAGE=none
SIM_POOL_SIZE=2

# 构建期的软件源镜像（可选）。留空/默认即官方源；国内网络可按下例改成镜像站。
# NPM_REGISTRY=https://registry.npmmirror.com
# MAVEN_MIRROR=https://maven.aliyun.com/repository/public
